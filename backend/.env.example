# 复制本文件为 .env 后按实际情况修改

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=sswhl_new

# ===== JWT =====
# 正式部署前务必换成一串随机字符
SECRET_KEY=please-change-this-to-a-random-secret-string
# token 有效期(分钟),默认 12 小时
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ===== 新用户初始密码(创建/重置用户时发放,首次登录强制修改) =====
INITIAL_PASSWORD=abc123456

# ===== 密码哈希胡椒(pepper) =====
# 一串随机字符,参与密码哈希计算;只保存在本文件,不进数据库不进代码库。
# 作用:即使数据库整库泄露,只要本文件没泄露,攻击者就无法离线破解密码。
# 生成方式:python -c "import secrets; print(secrets.token_hex(32))"
# 重要:一旦设置就不要更改或删除,否则所有用户将无法登录!
PASSWORD_PEPPER=请填入一串随机字符,留空表示不启用

# ===== 跨域:允许的前端地址,多个用英文逗号分隔 =====
CORS_ORIGINS=http://localhost:5173
