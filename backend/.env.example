# 复制本文件为 .env 后按实际情况修改

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=sswhl_new

# ===== JWT =====
# 正式部署前务必换成一串随机字符
SECRET_KEY=please-change-this-to-a-random-secret-string
# token 有效期(分钟),默认 12 小时
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ===== 新用户初始密码(创建/重置用户时发放,首次登录强制修改) =====
INITIAL_PASSWORD=abc123456

# ===== 密码哈希胡椒(pepper) =====
# 一串随机字符,参与密码哈希计算;只保存在本文件,不进数据库不进代码库。
# 作用:即使数据库整库泄露,只要本文件没泄露,攻击者就无法离线破解密码。
# 生成方式:python -c "import secrets; print(secrets.token_hex(32))"
# 重要:一旦设置就不要更改或删除,否则所有用户将无法登录!
PASSWORD_PEPPER=请填入一串随机字符,留空表示不启用

# ===== 跨域:允许的前端地址,多个用英文逗号分隔 =====
CORS_ORIGINS=http://localhost:5173

# ===== 测漏笔记 115 远程文件服务器(照旧系统地址,可按部署环境覆盖) =====
LEAK_REMOTE_UPLOAD_URL=http://172.16.80.115:8081/upload.ashx
LEAK_REMOTE_DELETE_URL=http://172.16.80.115:8081/Delete.ashx
LEAK_REMOTE_TIMEOUT=120
# ffmpeg 路径,留空自动查找 PATH 与旧系统 Tools/ffmpeg/ffmpeg.exe
LEAK_FFMPEG_PATH=

# ===== 短信网关(照旧 SmsSender.cs 的内部 ISW RPC 接口) =====
# 关闭后仍会写 sms_record,但不会调用网关(便于本地调试)
SMS_ENABLED=true
SMS_API_URL=http://172.16.110.170:8002/isw/wechat/api/console/rpc.jhtml
# AES-128-ECB 密钥,必须是 16 字节;正式环境建议换新值并同步网关
SMS_AES_KEY=__XM_SWJT__ISW__
SMS_TIMEOUT=8

# ===== 外部水务工单系统(旧站代理口溯源后的原始上游;旧站停运后直连) =====
# 工单详情(旧 ImageProxy/GetByNo -> getFlowInfoById)
WORKORDER_FLOW_URL=http://172.16.73.91/flowIntefaceCx/getFlowInfoById
WORKORDER_FLOW_APP_ID=EDA2AF854ECE454CB783563537EC9D97
WORKORDER_FLOW_VERSION=1.0
WORKORDER_FLOW_TIMEOUT=5
# 现场图片列表(旧 ImageProxy/GetWorkOrderImages -> appServeApi?state=formImageList)
WORKORDER_IMAGE_URL=http://172.16.80.129/appServe/appServeApi.do?state=formImageList
WORKORDER_IMAGE_APP_ID=xmsw20260506
WORKORDER_IMAGE_VERSION=1.0
# 图片直链白名单域名(旧 ImageProxy/GetImage 的 AllowedHosts)
WORKORDER_IMAGE_ALLOWED_HOST=172.16.80.129
WORKORDER_IMAGE_TIMEOUT=8