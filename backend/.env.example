# 复制本文件为 .env 后按实际情况修改

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=sswhl_new

# ===== JWT =====
# 正式部署前务必换成一串随机字符
SECRET_KEY=please-change-this-to-a-random-secret-string
# token 有效期(分钟),默认 12 小时
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ===== 新用户初始密码(创建/重置用户时发放,首次登录强制修改) =====
INITIAL_PASSWORD=abc123456

# ===== 跨域:允许的前端地址,多个用英文逗号分隔 =====
CORS_ORIGINS=http://localhost:5173
