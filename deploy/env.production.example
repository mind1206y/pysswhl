# 服务器生产环境配置模板(install.sh 会复制成 backend/.env 并填好密钥)
# 说明:数据库指向本机 Docker 里的 sswhl-mysql(宿主 127.0.0.1:13306),只监听本机。

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=sswhl_app
DB_PASSWORD=install.sh-会生成随机串
DB_NAME=sswhl_new

# ===== JWT =====
SECRET_KEY=install.sh-会生成随机串
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ===== 新用户初始密码(创建/重置用户时发放,首次登录强制修改) =====
INITIAL_PASSWORD=abc123456

# ===== 密码哈希胡椒(pepper) =====
# ⚠️ 导入现网数据时必须沿用开发机 backend/.env 里的同一个值,否则全部用户无法登录。
# install.sh 检测到已有 .env 时会原样保留,不会覆盖。
PASSWORD_PEPPER=install.sh-会生成随机串

# ===== 跨域:同源部署时基本用不到,填本机访问地址即可 =====
CORS_ORIGINS=http://127.0.0.1:18080

# ===== 生产开关 =====
# 由后端直接托管前端 dist(不装 nginx,对外只开一个端口)
SERVE_FRONTEND=true
# 关闭 /docs 与 /openapi.json
ENABLE_DOCS=false

# ===== 附件上传目录 =====
# 必须写绝对路径:代码里是 Path(settings.UPLOAD_DIR),留空会退化成"当前工作目录",
# 附件会散落到 backend/ 下而不是 uploads/。
UPLOAD_DIR=/opt/sswhl/backend/uploads

# ===== 热力图离线瓦片(留空则用 backend/assets/tiles) =====
CELOU_TILE_DIR=

# ===== 测漏笔记 115 远程文件服务器(按部署环境可用性确认) =====
LEAK_REMOTE_UPLOAD_URL=http://172.16.80.115:8081/upload.ashx
LEAK_REMOTE_DELETE_URL=http://172.16.80.115:8081/Delete.ashx
LEAK_REMOTE_TIMEOUT=120
LEAK_FFMPEG_PATH=

# ===== 短信网关 =====
SMS_ENABLED=true
SMS_API_URL=http://172.16.110.170:8002/isw/wechat/api/console/rpc.jhtml
SMS_AES_KEY=__XM_SWJT__ISW__
SMS_TIMEOUT=8

# ===== 外部水务工单系统 =====
WORKORDER_FLOW_URL=http://172.16.73.91/flowIntefaceCx/getFlowInfoById
WORKORDER_FLOW_APP_ID=EDA2AF854ECE454CB783563537EC9D97
WORKORDER_FLOW_VERSION=1.0
WORKORDER_FLOW_TIMEOUT=5
WORKORDER_IMAGE_URL=http://172.16.80.129/appServe/appServeApi.do?state=formImageList
WORKORDER_IMAGE_APP_ID=xmsw20260506
WORKORDER_IMAGE_VERSION=1.0
WORKORDER_IMAGE_ALLOWED_HOST=172.16.80.129
WORKORDER_IMAGE_TIMEOUT=8
